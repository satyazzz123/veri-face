# ==============================================================================
# Image Upload & Validation Platform - Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL)
# e.g., postgresql://postgres:postgres@localhost:5432/image_val?schema=public
DATABASE_URL="postgresql://image_val_app:admin@localhost:5432/image_val_db"

# Redis Configuration (BullMQ & Cache)
# e.g., redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# Object Storage Configuration (S3 / MinIO)
# e.g. for MinIO: S3_ENDPOINT="http://localhost:9000"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="admin"
S3_SECRET_KEY="admin"
S3_BUCKET="image-uploads"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# Server & Application Configuration
NODE_ENV="development"
PORT="4000"
WEB_URL="http://localhost:3000"

# Upload Restriction Limits
MAX_FILE_SIZE_MB="10"
MAX_FILES_PER_REQUEST="10"

# Image Dimension & Pixel Limits
MIN_IMAGE_WIDTH="512"
MIN_IMAGE_HEIGHT="512"
MIN_IMAGE_SIZE_BYTES="10240"
MAX_IMAGE_PIXELS="40000000"

# Validation Thresholds
BLUR_THRESHOLD="100"
FACE_MIN_AREA_RATIO="0.05"
SIMILARITY_THRESHOLD="8"

# Background Worker Concurrency
WORKER_CONCURRENCY="3"

# Local Temporary File Upload Staging Directory
UPLOAD_DIR="./tmp/uploads"
