{
  "name": "@image-val/image-processing",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "@image-val/shared": "workspace:*",
    "heic-convert": "^2.1.0",
    "onnxruntime-node": "^1.21.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.3.6",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
