    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prisma": "^5.22.0",
    "tsup": "^8.3.6",
    "typescript": "^5.8.2"
  }
}
