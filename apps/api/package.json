{
  "name": "@image-val/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/workers/image-processor.worker.ts --format esm",
    "dev": "tsx watch src/index.ts",
    "worker:dev": "tsx watch src/workers/image-processor.worker.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/image-processor.worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@image-val/database": "workspace:*",
    "@image-val/image-processing": "workspace:*",
    "@image-val/shared": "workspace:*",
    "bullmq": "^5.41.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "multer": "1.4.5-lts.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
